# Bitcoin Core settings for deep pool's node.
# On macOS this file goes in: ~/Library/Application Support/Bitcoin/bitcoin.conf

# Keep the chain on the external SSD (about 750 GB in late 2026, plus ~60 GB for txindex)
datadir=/Volumes/BitcoinSSD/Bitcoin

# Full, unpruned node with a transaction index (the mempool backend needs both)
prune=0
txindex=1

# No wallet: there are no coins on this machine to steal, and RPC can't spend anything
disablewallet=1

# RPC for the mempool backend, on this Mac only. Never forward port 8332 on the router.
server=1
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcuser=deeppool
rpcpassword=change-me-to-a-long-random-password

# Faster first sync on a Mac mini with 16 GB+ of memory; lower it (e.g. 2000) on 8 GB
dbcache=4000

# Normal peer-to-peer networking (outbound works behind the router with nothing to configure)
listen=1
