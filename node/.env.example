# Copy to .env and fill in. .env holds passwords: never commit it (it's in .gitignore).

# Where the indexes live. Put it on the same big external SSD as the blockchain.
DATA_DIR=/Volumes/BitcoinSSD/deep-pool-node

# Must match rpcuser / rpcpassword in bitcoin.conf
BITCOIN_RPC_USER=deeppool
BITCOIN_RPC_PASSWORD=change-me-to-a-long-random-password

# Database passwords (only used inside Docker)
DB_PASSWORD=change-me-too
DB_ROOT_PASSWORD=change-me-as-well

# deep pool's address as browsers see it: scheme + host, no path, no trailing slash.
# A GitHub Pages project site at https://jamalxcode.github.io/deep_pool/ has the origin below;
# with a custom domain it would be e.g. https://deeppool.sala.company
DEEPPOOL_ORIGIN=https://jamalxcode.github.io

# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> "Install connector" (the long token)
CLOUDFLARE_TUNNEL_TOKEN=
